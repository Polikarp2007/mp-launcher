<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PoliCoLauncherApp.Views.HistoryPageView">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <StackPanel Grid.Column="0" Margin="25,90,15,0">
            <TextBlock Text="My Trips"
                       FontSize="18" FontWeight="Bold" Foreground="#000000"
                       Margin="10,12,0,12"/>
            <Button Height="44" Click="OnBackClick"
                    Background="#3458e1" BorderThickness="0" CornerRadius="6"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Margin="2,0,2,0">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2547c7"/>
                    </Style>
                </Button.Styles>
                <TextBlock Text="← Dashboard"
                           Foreground="White" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1" Margin="20,100,25,45">
            <StackPanel VerticalAlignment="Top" Margin="0,35,0,0" Spacing="10">
                <TextBlock Text="Connection History" FontSize="26" FontWeight="Bold" Foreground="#000000"/>

                <TextBlock x:Name="HistoryStatusText" Text="Loading..." FontSize="13" Foreground="#888888"/>

                <Border x:Name="HistoryListBorder"
                        Background="#F9F9F9"
                        BorderBrush="#EEEEEE"
                        BorderThickness="1"
                        CornerRadius="15"
                        Height="245"
                        VerticalAlignment="Top"
                        ClipToBounds="True"
                        Padding="0"
                        IsVisible="False">
                    <ScrollViewer VerticalScrollBarVisibility="Visible" Height="245" Padding="15,15,15,15">
                        <StackPanel x:Name="HistoryContainer" Spacing="0"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <!-- SEPARATOR LINE -->
        <Border Height="1" Background="#F0F0F0" VerticalAlignment="Top" Margin="25,82,25,0"/>

        <!-- LOGO -->
        <Image Source="/Assets/logo.png"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Width="180" Height="47"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="25,23,0,0" ZIndex="1000"
               PointerPressed="OnLogoPressed"
               Cursor="Hand"
               Grid.ColumnSpan="2"/>
    </Grid>
</UserControl>
